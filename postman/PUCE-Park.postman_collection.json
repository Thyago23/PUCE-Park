{
  "info": {
    "name": "PUCE-Park API",
    "description": "API de gestión de parqueo universitario — Spring Boot 4 + Kotlin + AWS Cognito JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tokenDriver",
      "value": "PEGA_AQUI_JWT_DEL_DRIVER",
      "type": "string"
    },
    {
      "key": "tokenGuard",
      "value": "PEGA_AQUI_JWT_DEL_GUARD",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "PEGA_AQUI_JWT_DEL_ADMIN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Zonas de Parqueo",
      "item": [
        {
          "name": "GET todas las zonas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas"]
            },
            "description": "Público — no requiere token. Retorna todas las zonas con su capacidad."
          }
        },
        {
          "name": "GET estadísticas de zona",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1/estadisticas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1", "estadisticas"]
            },
            "description": "Público — no requiere token. Retorna disponibles, ocupados y total de una zona."
          }
        },
        {
          "name": "POST crear zona",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Zona A\",\n  \"descripcion\": \"Zona principal edificio central\",\n  \"capacidadMaxima\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas"]
            },
            "description": "Requiere rol ADMIN. Retorna 201 con la zona creada."
          }
        },
        {
          "name": "PUT actualizar zona",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Zona A Modificada\",\n  \"descripcion\": \"Descripción actualizada\",\n  \"capacidadMaxima\": 15\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1"]
            },
            "description": "Requiere rol ADMIN. Lanza 409 si el nombre ya existe en otra zona."
          }
        },
        {
          "name": "DELETE eliminar zona",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1"]
            },
            "description": "Requiere rol ADMIN. Retorna 204. Lanza 409 si la zona tiene puestos asignados."
          }
        }
      ]
    },
    {
      "name": "Puestos de Parqueo",
      "item": [
        {
          "name": "GET puestos por zona",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/zona/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "zona", "1"]
            },
            "description": "Público — no requiere token. Lista todos los puestos de la zona con su estado."
          }
        },
        {
          "name": "POST crear puesto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zonaId\": 1,\n  \"numeroPuesto\": \"A01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos"]
            },
            "description": "Requiere rol ADMIN. Retorna 201. Lanza 409 si el numeroPuesto ya existe en esa zona o si la zona está llena."
          }
        },
        {
          "name": "PUT renombrar puesto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroPuesto\": \"A01-MOD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1"]
            },
            "description": "Requiere rol ADMIN. Renombra el puesto dentro de su misma zona."
          }
        },
        {
          "name": "PUT ocupar puesto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenDriver}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/ocupar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "ocupar"]
            },
            "description": "Requiere rol DRIVER. Marca el puesto como OCUPADO y registra el historial. Lanza 409 si ya está ocupado."
          }
        },
        {
          "name": "PUT liberar puesto",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenDriver}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/liberar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "liberar"]
            },
            "description": "Requiere rol DRIVER. Solo puede liberar el puesto el mismo usuario que lo ocupó. Lanza 409 si ya está disponible, 403 si es otro usuario."
          }
        },
        {
          "name": "PUT forzar liberación (guardia)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenGuard}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/forzar-liberacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "forzar-liberacion"]
            },
            "description": "Requiere rol GUARD. Libera el puesto sin importar qué usuario lo ocupó."
          }
        }
      ]
    },
    {
      "name": "Historial de Parqueo",
      "item": [
        {
          "name": "GET mi historial",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenDriver}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "me"]
            },
            "description": "Requiere rol DRIVER. Retorna el historial completo del usuario autenticado, ordenado por fecha de ingreso descendente."
          }
        },
        {
          "name": "GET historial por puesto",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenGuard}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/puesto/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "puesto", "1"]
            },
            "description": "Requiere rol GUARD o ADMIN. Retorna todo el historial de ocupaciones de un puesto específico."
          }
        }
      ]
    },
    {
      "name": "Perfil de Usuario",
      "item": [
        {
          "name": "GET mi perfil",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenDriver}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me"]
            },
            "description": "Requiere rol DRIVER. Retorna el perfil del usuario autenticado. Si no existe, lo crea automáticamente."
          }
        },
        {
          "name": "PUT actualizar perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenDriver}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Bryan Taco\",\n  \"placaVehiculo\": \"ABC-1234\",\n  \"modoOscuro\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me"]
            },
            "description": "Requiere rol DRIVER. Actualiza nombre completo, placa y preferencia de modo oscuro."
          }
        }
      ]
    }
  ]
}
