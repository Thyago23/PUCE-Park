{
  "info": {
    "name": "PucePark API",
    "_postman_id": "puce-park-api-v1",
    "description": "REST API for the PUCE parking system. All endpoints require Bearer token (JWT from AWS Cognito).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_JWT_HERE",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Parking Zones",
      "item": [
        {
          "name": "GET All zones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas"]
            },
            "description": "Returns all zones with availability. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "GET Zone statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1/estadisticas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1", "estadisticas"]
            },
            "description": "Returns occupancy statistics for a zone. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "POST Create zone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zone A\",\n  \"description\": \"North campus zone\",\n  \"maxCapacity\": 20,\n  \"location\": \"North Building\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas"]
            },
            "description": "Creates a new parking zone. Role: ADMIN."
          }
        },
        {
          "name": "PUT Update zone",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zone A Updated\",\n  \"description\": \"North campus zone - expanded\",\n  \"maxCapacity\": 30,\n  \"location\": \"North Building Wing 2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1"]
            },
            "description": "Updates an existing zone. Role: ADMIN."
          }
        },
        {
          "name": "DELETE Delete zone",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/zonas/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "zonas", "1"]
            },
            "description": "Deletes a zone with no assigned spaces. Role: ADMIN."
          }
        }
      ]
    },
    {
      "name": "Parking Spaces",
      "item": [
        {
          "name": "GET All spaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos"]
            },
            "description": "Returns all spaces across all zones. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "GET Spaces by zone",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/zona/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "zona", "1"]
            },
            "description": "Returns spaces in a specific zone sorted by row and order. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "POST Create space",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneId\": 1,\n  \"spaceNumber\": \"A-01\",\n  \"row\": \"A\",\n  \"order\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos"]
            },
            "description": "Creates a new space in a zone. Role: ADMIN."
          }
        },
        {
          "name": "PUT Update space",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceNumber\": \"A-01-BIS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1"]
            },
            "description": "Updates a space number. Role: ADMIN."
          }
        },
        {
          "name": "PUT Occupy space (student)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/ocupar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "ocupar"]
            },
            "description": "Student occupies the space using their JWT. Requires complete profile (fullName + vehiclePlate + permitNumber). Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "PUT Release space (student)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/liberar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "liberar"]
            },
            "description": "Student releases their own space. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "PUT Force occupy (guard)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiclePlate\": \"ABC-1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/forzar-ocupacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "forzar-ocupacion"]
            },
            "description": "Guard manually occupies a space for a specific vehicle. Roles: ADMIN, GUARD."
          }
        },
        {
          "name": "PUT Force release (guard)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/puestos/1/forzar-liberacion",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "puestos", "1", "forzar-liberacion"]
            },
            "description": "Guard releases any space regardless of who occupies it. Roles: ADMIN, GUARD."
          }
        }
      ]
    },
    {
      "name": "Parking History",
      "item": [
        {
          "name": "GET My history (student)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "me"]
            },
            "description": "History of the authenticated student sorted by date desc. Roles: ADMIN, USER."
          }
        },
        {
          "name": "GET My personal statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/me/estadisticas?mes=2026-08",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "me", "estadisticas"],
              "query": [
                { "key": "mes", "value": "2026-08", "description": "Format: YYYY-MM" }
              ]
            },
            "description": "Monthly stats: total sessions, hours and average. Roles: ADMIN, USER."
          }
        },
        {
          "name": "GET My history (guard)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/guardia/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "guardia", "me"]
            },
            "description": "History of actions by the authenticated guard. Roles: ADMIN, GUARD."
          }
        },
        {
          "name": "GET History by space",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/puesto/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "puesto", "1"]
            },
            "description": "Full history of a specific space. Roles: ADMIN, GUARD."
          }
        },
        {
          "name": "GET Monthly ranking",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/historial/ranking/mensual?mes=2026-08",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "historial", "ranking", "mensual"],
              "query": [
                { "key": "mes", "value": "2026-08", "description": "Format: YYYY-MM" }
              ]
            },
            "description": "Student ranking by parking hours in the month (excludes GUARD entries). Roles: ADMIN, GUARD, USER."
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "GET My profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me"]
            },
            "description": "Gets (or creates if not exists) the authenticated user's profile. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "GET Profile status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me", "estado"]
            },
            "description": "Indicates whether the profile is complete and which fields are missing. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "PUT Update profile (student)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Bryan Taco\",\n  \"vehiclePlate\": \"ABC-1234\",\n  \"permitNumber\": \"P-00123\",\n  \"darkMode\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me"]
            },
            "description": "Updates the student profile data. Roles: ADMIN, GUARD, USER."
          }
        },
        {
          "name": "PUT Update profile (guard)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Carlos Guard\",\n  \"vehiclePlate\": \"\",\n  \"permitNumber\": \"\",\n  \"darkMode\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/perfil/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "perfil", "me"]
            },
            "description": "Updates a guard profile (vehiclePlate and permitNumber left empty). Roles: ADMIN, GUARD, USER."
          }
        }
      ]
    }
  ]
}
